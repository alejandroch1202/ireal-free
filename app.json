{
  "expo": {
    "name": "iReal Free",
    "slug": "ireal-free",
    "version": "1.0.0",
    "scheme": "irealb",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML Document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.html"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.irealfree.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EA580C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "irealb"
            },
            {
              "scheme": "irealbook"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "text/html"
            },
            {
              "scheme": "file",
              "mimeType": "text/html"
            },
            {
              "scheme": "content",
              "mimeType": "application/xhtml+xml"
            },
            {
              "scheme": "file",
              "mimeType": "application/xhtml+xml"
            },
            {
              "scheme": "content",
              "mimeType": "text/plain",
              "pathPattern": ".*\\.html"
            },
            {
              "scheme": "file",
              "mimeType": "text/plain",
              "pathPattern": ".*\\.html"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.html"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.html"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-sharing",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "d1cb69c3-7215-40b1-a7ae-f4cdaba9dabf"
      }
    },
    "owner": "alejandroch1202"
  }
}
